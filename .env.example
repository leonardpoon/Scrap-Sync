# ─────────────────────────────────────────────────────────────
# Scrap&Sync configuration. Copy this file to ".env" and fill in.
# ─────────────────────────────────────────────────────────────

# --- Telegram ---
# Get this from @BotFather on Telegram (see README, "Telegram bot setup").
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# BotFather username without @. Needed to generate contribution deep links.
TELEGRAM_BOT_USERNAME=scrap_sync_dev_bot

# --- PostgreSQL ---
# Local PostgreSQL 17 connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://scrapsync:scrapsync@localhost:5434/scrapsync

# --- Web viewer ---
# Public base URL of the web viewer. Used to build the shareable link
# the bot returns after /new. For local dev this is http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Media storage (local disk adapter) ---
# Folder where uploaded photos are written, and the URL path they are served on.
MEDIA_DIR=./media
MEDIA_URL_PREFIX=/media

# Set MEDIA_PROVIDER=supabase in Render. The service-role key stays server-side;
# never expose it in a browser or commit it to Git.
MEDIA_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scrapbook-media
