# ─────────────────────────────────────────────────────────────
# Scrap&Sync configuration. Copy this file to ".env" and fill in.
# ─────────────────────────────────────────────────────────────

# --- Telegram ---
# Get this from @BotFather on Telegram (see README, "Telegram bot setup").
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# BotFather username without @. Needed to generate contribution deep links.
TELEGRAM_BOT_USERNAME=scrap_sync_dev_bot

# --- PostgreSQL ---
# Local PostgreSQL 17 connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://scrapsync:scrapsync@localhost:5434/scrapsync
# Optional CA certificate used to verify the Supabase database server.
DATABASE_SSL_CA_FILE=

# --- Web viewer ---
# Public base URL of the web viewer. Used to build the shareable link
# the bot returns after /new. For local dev this is http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Media storage (local disk adapter) ---
# Folder where uploaded photos are written, and the URL path they are served on.
MEDIA_DIR=./media
MEDIA_URL_PREFIX=/media

# Supabase is used only for its PostgreSQL database in the production setup.
# These storage values are unused when MEDIA_PROVIDER=r2.
MEDIA_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scrapbook-media

# --- Cloudflare R2 media storage ---
# Set MEDIA_PROVIDER=r2 in deployment. Keep these server-only and never commit
# them; R2 API credentials can upload to the configured bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scrapsync-media
R2_PUBLIC_BASE_URL=https://pub-2c30554a897a447282f6f5e83a83f5af.r2.dev

# --- Image optimisation ---
# Every Telegram photo is auto-oriented, constrained to this longest edge, and
# stored as a progressive JPEG. Smaller images are never enlarged.
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=82
# Maximum stored size for each optimized photo, in bytes (200 KiB).
IMAGE_MAX_BYTES=204800
IMAGE_MAX_INPUT_PIXELS=100000000
